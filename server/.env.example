# Oppure usa OpenAI (cloud, a pagamento):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-proj-...

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
